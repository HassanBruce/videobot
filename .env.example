# ---------- Channel ----------
CHANNEL_NAME=Road to AI Automation
NICHE=AI automation and cloud engineering for beginners in Pakistan
PLAYLIST_NAME=Road to AI automation and cloud engineer
# ur = Urdu voice, en = English, hi = Hindi
NARRATION_LANG=ur
# Urdu voices: ur-PK-AsadNeural (male), ur-PK-UzmaNeural (female)
VOICE=ur-PK-AsadNeural
VOICE_RATE=+0%
# landscape = normal YouTube video, vertical = Shorts/Reels
VIDEO_FORMAT=landscape
TARGET_MINUTES=4
ACCENT_COLOR=#2D6CDF

# ---------- AI (same Gemini key as the other bots) ----------
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# ---------- YouTube (see README: Google Cloud → OAuth client → scripts/youtube_auth.py) ----------
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=private

# ---------- Facebook Page ----------
FB_PAGE_ID=
FB_PAGE_TOKEN=
# false = Facebook only after: python -m videobot approve <id>
FB_AUTO_PUBLISH=false

# ---------- Schedule (Pakistan time). 3 per week is safer than daily. ----------
SCHEDULE_DAYS=mon,wed,fri
SCHEDULE_HOUR_PKT=18

# ---------- Telegram (optional, same bot as portfolio bot) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
